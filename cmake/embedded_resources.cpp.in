#include "vz256/embedded_resources.hpp"

#include <array>

namespace vz256 {
namespace {

constexpr std::array<std::uint8_t, @MONITOR_ROM_SIZE@> monitor_rom{@MONITOR_ROM_BYTES@};
constexpr std::array<std::uint8_t, @CHARACTER_ROM_SIZE@> character_rom{@CHARACTER_ROM_BYTES@};

} // namespace

std::span<const std::uint8_t> embedded_monitor_rom() { return monitor_rom; }
std::span<const std::uint8_t> embedded_character_rom() { return character_rom; }

} // namespace vz256
